rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Contacts Address Book
    match /users/{userId}/contacts/{contactId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Scheduled Emails Queue
    match /users/{userId}/scheduledEmails/{emailId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Email Activity Logs
    match /users/{userId}/emailLogs/{logId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Saved Reusable Attachments
    match /users/{userId}/savedAttachments/{attachmentId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // User Sender / SMTP Settings
    match /users/{userId}/settings/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
